{
  "name": "ledgerline-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port ${PORT:-4200}",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "start:en": "ng serve -c en --port ${PORT:-4300}",
    "test:coverage": "ng test --watch=false --coverage",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "e2e": "playwright test",
    "i18n": "ng extract-i18n --output-path src/locale && python3 tools/build-translation.py",
    "start:kind": "ng serve -c kind --port 4200"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@microsoft/signalr": "^10.0.11",
    "@ngrx/signals": "^22.0.1",
    "oidc-client-ts": "^3.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/localize": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
