{
  "realm": "ledgerline",
  "displayName": "Ledgerline",
  "loginTheme": "ledgerline",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Retail banking customer"
      },
      {
        "name": "operator",
        "description": "Back-office operator: fraud reviews, books"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ledgerline-web",
      "name": "Ledgerline web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "redirectUris": [
        "http://localhost:4200/*",
        "https://ledgerline-bank.vercel.app/*"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "web-origins",
        "acr"
      ],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ledgerline-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "flat roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "a11ce000-0000-4000-8000-000000000001",
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Martin",
      "email": "alice@ledgerline.invalid",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "ledgerline-demo",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ]
    },
    {
